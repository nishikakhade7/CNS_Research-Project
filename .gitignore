Dataset/
*.csv
*.parquet
*.pkl
*.pickle
*.h5
*.hdf5
*.npz
*.npy

# ------ Model artifacts & experiment outputs ----------------
models/
artifacts/
outputs/
results/
runs/
mlruns/
*.pt
*.pth
*.onnx
*.joblib
*.bin

# ------ Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------ Virtual environments ---------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/

# ------ Jupyter ----------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------ IDE / editors ----------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------ OS junk ----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------ Secrets / credentials --------------------------------
.env
.env.*
secrets.json
config_local.py

# ------ Logs & temp ------------------------------------------
*.log
*.tmp
*.temp
logs/
